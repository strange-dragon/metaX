# Copy this file to .env and fill in only the values you need.
# Never commit the real .env file.
#
# The Jellyfin plugin is the normal owner of provider cookies. These
# environment values are only a fallback for deployments that cannot send
# request-scoped cookies yet.

# Host port for the backend.
METAX_PORT=8080

# Optional API token. Configure the same token in the Jellyfin plugin.
# METAX_TOKEN=

# Optional route table overrides. Inline JSON wins over the file path.
# METAX_ROUTES={"routes":{"censored":["FANZA","JavDB"],"western":["ThePornDB"]}}
# METAX_ROUTES_FILE=/data/routes.json
# METAX_ROUTES_FINGERPRINT=

# Aggregation cache/fan-out controls.
# METAX_AGGREGATE_CACHE_TTL=10m
# METAX_AGGREGATE_CACHE_MAX=256
# METAX_AGGREGATE_FANOUT=16

# Provider cookie fallback (do not commit real values).
# MT_MOVIE_PROVIDER_JAVDB__COOKIES=
# MT_MOVIE_PROVIDER_FREEJAVBT__COOKIES=
# MT_MOVIE_PROVIDER_FALENO__COOKIES=
# MT_MOVIE_PROVIDER_MGSTAGE__COOKIES=
# MT_MOVIE_PROVIDER_FC2PPVDB__COOKIES=
# MT_MOVIE_PROVIDER_FALENO__PROXY=http://proxy.example:8080
# MT_MOVIE_PROVIDER_MGSTAGE__PROXY=socks5://proxy.example:1080

# ThePornDB tokens (the provider stays unavailable without one).
# MT_ACTOR_PROVIDER_THEPORNDBACTOR__ACCESS_TOKEN=
# MT_MOVIE_PROVIDER_THEPORNDBSCENE__ACCESS_TOKEN=
# MT_MOVIE_PROVIDER_THEPORNDBMOVIE__ACCESS_TOKEN=

# Build pin overrides (normally leave these alone).
# GO_VERSION=1.26
# SDK_REPOSITORY=https://github.com/metatube-community/metatube-sdk-go.git
# SDK_COMMIT=c62584675c593816cc07e7b5b977d14c7eb505a3
