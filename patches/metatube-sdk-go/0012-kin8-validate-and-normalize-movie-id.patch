diff --git a/provider/kin8tengoku/kin8tengoku.go b/provider/kin8tengoku/kin8tengoku.go
index 1234567..89abcde 100644
--- a/provider/kin8tengoku/kin8tengoku.go
+++ b/provider/kin8tengoku/kin8tengoku.go
@@ -45,6 +45,11 @@ func (k8 *KIN8) NormalizeMovieID(id string) string {
-	if ss := regexp.MustCompile(`^(?i)(?:kin8[-_])?(\d+)$`).FindStringSubmatch(id); len(ss) == 2 {
-		return ss[1]
-	}
-	return ""
+	ss := regexp.MustCompile(`(?i)^(?:KIN8(?:TENGOKU)?[-_ ]?)?(\d+)$`).FindStringSubmatch(strings.TrimSpace(id))
+	if len(ss) != 2 {
+		return ""
+	}
+	value := strings.TrimLeft(ss[1], "0")
+	if value == "" || len(value) > 4 {
+		return ""
+	}
+	return strings.Repeat("0", 4-len(value)) + value
 }
 
-func (k8 *KIN8) GetMovieInfoByID(id string) (info *model.MovieInfo, err error) {
-	return k8.GetMovieInfoByURL(fmt.Sprintf(movieURL, id))
+func (k8 *KIN8) GetMovieInfoByID(id string) (info *model.MovieInfo, err error) {
+	normalized := k8.NormalizeMovieID(id)
+	if normalized == "" {
+		return nil, fmt.Errorf("kin8: invalid movie ID %q", id)
+	}
+	return k8.GetMovieInfoByURL(fmt.Sprintf(movieURL, normalized))
 }
diff --git a/provider/kin8tengoku/kin8tengoku_migration_test.go b/provider/kin8tengoku/kin8tengoku_migration_test.go
