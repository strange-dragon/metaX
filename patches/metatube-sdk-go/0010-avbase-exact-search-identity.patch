+func (ab *AVBase) searchWorks(keyword string) (works []workResponse, err error) {
 	buildID, err := ab.GetBuildID()
 	if err != nil {
 		return
@@ -224,7 +225,7 @@ func (ab *AVBase) SearchMovie(keyword string) (results []*model.MovieSearchResult
 		data := struct {
